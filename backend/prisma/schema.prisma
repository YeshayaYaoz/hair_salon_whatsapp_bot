generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id                 String @id @default(cuid())
  name               String
  timezone           String @default("Asia/Jerusalem")
  email              String @unique
  passwordHash       String
  subscriptionStatus String @default("trial") // trial | active | past_due | canceled

  // Super-admin block: independent of subscriptionStatus — a blocked business is locked out of
  // login and the bot stops replying, regardless of whether their subscription is otherwise fine
  // (e.g. abuse, fraud, a support dispute), without touching their billing state.
  blockedAt     DateTime?
  blockedReason String?

  // Own-account recurring billing via PayPlus tokens — charges the business (salon owner) for
  // their Tori subscription. Separate from paymentProvider/paymentApiKey above, which are the
  // salon's own merchant account for charging their customers, not this.
  subscriptionPlan          String? // "standard" | "premium"
  subscriptionToken         String? // encrypted at rest — PayPlus recurring charge token
  nextBillingDate           DateTime?
  lastBillingAttemptAt      DateTime?
  billingCycle              String    @default("monthly") // "monthly" | "annual"
  billingCyclesCompleted    Int       @default(0) // successful charges — drives the loyalty discount
  loyaltyDiscountIls        Int       @default(0) // auto-applied recurring discount once tenure threshold is hit
  lastBillingReminderSentAt DateTime? // last "charge in 2 days" heads-up, to avoid duplicates
  walletBalanceAgorot       Int       @default(0) // prepaid balance in agorot (1/100 ILS) — funds metered add-ons once the plan's monthly message quota is exceeded
  messagesUsedThisCycle     Int       @default(0) // proactive WhatsApp sends (reminders/reviews/digests/etc.) counted against the plan quota this billing cycle; reset on each successful charge
  pendingYieldCampaign      Json? // set when the empty-slot campaign is awaiting the owner's WhatsApp confirmation
  address                   String?
  whatsappPhoneNumberId     String?   @unique
  whatsappAccessToken       String? // encrypted at rest
  whatsappTokenValid        Boolean   @default(true) // set false when Meta rejects the token (expired/revoked)
  notificationPhone         String? // owner's personal phone for booking alerts
  botGreeting               String? // custom greeting override
  botPersonality            String? // tone/personality instructions for the bot
  googleMapsUrl             String? // linked in post-visit review requests
  remindersEnabled          Boolean   @default(true)
  reviewsEnabled            Boolean   @default(true)
  cancellationPolicy        String? // shown by the bot when a customer cancels
  referralText              String? // appended to post-visit review messages (e.g. referral discount offer)
  digestEnabled             Boolean   @default(true)
  lastDigestSentAt          DateTime? // last morning-digest send, to avoid duplicates
  lastRoiReportSentAt       DateTime? // last monthly ROI report send, to avoid duplicates

  // Per-business transaction (payment) provider — the salon's own merchant account, not ours.
  paymentProvider  String? // "payplus" | "tranzila" | "cardcom"
  paymentApiKey    String? // encrypted at rest — provider's key/terminal/username
  paymentApiSecret String? // encrypted at rest — provider's secret/password

  // Per-business Israeli invoice/receipt provider — issues the actual חשבונית/קבלה after payment.
  invoiceProvider  String? // "greeninvoice" | "icount"
  invoiceApiKey    String? // encrypted at rest
  invoiceApiSecret String? // encrypted at rest

  // Deposit-before-booking: when enabled (requires a connected paymentProvider), the bot sends a
  // payment link for a fixed deposit instead of confirming the slot outright — the appointment
  // holds the slot as "pending_payment" until paid or it expires. Owner opt-in per spec.
  depositEnabled     Boolean @default(false)
  depositAmountIls   Int     @default(0)
  depositHoldMinutes Int     @default(30) // how long an unpaid hold blocks the slot before auto-expiring

  createdAt DateTime @default(now())

  services            Service[]
  staff               StaffMember[]
  hours               BusinessHours[]
  customers           Customer[]
  appointments        Appointment[]
  faqEntries          FaqEntry[]
  waitlistEntries     WaitlistEntry[]
  passwordResetTokens PasswordResetToken[]
  googleCalendar      GoogleCalendarToken?
  blockedTimes        BlockedTime[]
}

/// Tracks the last run of each global background job (reminders, reviews, digest, retention) so
/// its health can be surfaced in the dashboard instead of living only in Railway logs.
model SystemJobRun {
  jobName        String   @id
  lastRunAt      DateTime
  lastStatus     String // "ok" | "error"
  lastError      String?
  lastDurationMs Int?
}

/// Owner-defined closures (vacations, lunch breaks, holidays) during which no bookings are allowed.
model BlockedTime {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  startTime  DateTime
  endTime    DateTime
  reason     String?
  createdAt  DateTime @default(now())

  @@index([businessId, startTime])
}

model Service {
  id              String          @id @default(cuid())
  business        Business        @relation(fields: [businessId], references: [id])
  businessId      String
  name            String
  description     String?
  priceCents      Int
  durationMin     Int
  color           String          @default("#8b5cf6")
  appointments    Appointment[]
  waitlistEntries WaitlistEntry[]

  @@index([businessId])
}

model StaffMember {
  id           String        @id @default(cuid())
  business     Business      @relation(fields: [businessId], references: [id])
  businessId   String
  name         String
  appointments Appointment[]

  @@index([businessId])
}

model BusinessHours {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  dayOfWeek  Int // 0 = Sunday ... 6 = Saturday
  openMin    Int // minutes from midnight
  closeMin   Int

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

model Customer {
  id                  String          @id @default(cuid())
  business            Business        @relation(fields: [businessId], references: [id])
  businessId          String
  phone               String
  name                String?
  preferredServiceId  String? // most recently booked service, for CRM memory
  lastRetentionSentAt DateTime? // when we last sent a re-engagement message
  notes               String? // free-text staff note about this customer, shown next to their conversation
  botPaused           Boolean         @default(false) // true once the owner sends a manual message — bot goes silent on this thread until resumed
  botPausedAt         DateTime?
  appointments        Appointment[]
  waitlistEntries     WaitlistEntry[]

  @@unique([businessId, phone])
  @@index([businessId])
}

model Appointment {
  id              String       @id @default(cuid())
  business        Business     @relation(fields: [businessId], references: [id])
  businessId      String
  customer        Customer     @relation(fields: [customerId], references: [id])
  customerId      String
  service         Service      @relation(fields: [serviceId], references: [id])
  serviceId       String
  staff           StaffMember? @relation(fields: [staffId], references: [id])
  staffId         String?
  startTime       DateTime
  endTime         DateTime
  status          String       @default("confirmed") // confirmed | cancelled | pending_payment
  reminderSentAt  DateTime? // set when 24h reminder WhatsApp is sent
  reviewSentAt    DateTime? // set when post-visit review request is sent
  calendarEventId String? // Google Calendar event id, so cancel/reschedule can delete the actual event instead of leaving a ghost
  createdAt       DateTime     @default(now())

  // Deposit tracking — only set when the appointment was created via the deposit-required flow.
  depositAmountIls   Int?
  depositStatus      String?   @default("none") // none | pending | paid
  depositProvider    String? // payment provider name at time of link creation, e.g. "payplus"
  depositPaymentUrl  String?
  depositProviderRef String? // provider's transaction/page id, used to correlate the webhook
  depositExpiresAt   DateTime? // pending_payment holds past this are auto-cancelled to free the slot
  depositPaidAt      DateTime?

  @@index([businessId, startTime])
  @@index([status, depositExpiresAt])
}

model WaitlistEntry {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String
  service    Service  @relation(fields: [serviceId], references: [id])
  serviceId  String
  notified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([businessId])
}

model FaqEntry {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  question   String
  answer     String

  @@index([businessId])
}

model GoogleCalendarToken {
  id           String   @id @default(cuid())
  business     Business @relation(fields: [businessId], references: [id])
  businessId   String   @unique
  accessToken  String // encrypted
  refreshToken String // encrypted
  expiresAt    DateTime
  calendarId   String   @default("primary")
  updatedAt    DateTime @updatedAt
}

model ConversationMessage {
  id         String   @id @default(cuid())
  businessId String
  phone      String
  role       String // "user" | "assistant"
  content    String
  createdAt  DateTime @default(now())

  @@index([businessId, phone, createdAt])
}

// Real, per-call usage ledger — no estimates. Every Anthropic API call and every billable
// WhatsApp message actually sent is logged here with its real token counts / billing category, so
// cost-per-phone-number in the super-admin panel reflects what was actually metered by the
// provider, not a guessed average. costAgorot is only populated when we have an authoritative
// published rate to compute it from (Claude token pricing); WhatsApp entries record the real
// category/billable flag Meta itself reports, since Meta doesn't return a $ amount per message —
// only the account's own invoice has that, and we don't fabricate a number to fill the gap.
model ApiUsageEvent {
  id           String   @id @default(cuid())
  businessId   String
  customerPhone String
  kind         String // "claude" | "whatsapp"
  model        String? // Claude model id, e.g. "claude-haiku-4-5-20251001"
  inputTokens  Int?
  outputTokens Int?
  costAgorot   Int? // only set when computed from a known published rate (Claude); null for WhatsApp
  category     String? // WhatsApp billing category Meta reports: marketing | utility | authentication | service
  billable     Boolean? // WhatsApp: Meta's own "billable" flag for this message
  createdAt    DateTime @default(now())

  @@index([businessId, customerPhone, createdAt])
  @@index([businessId, kind, createdAt])
}

// Records every super-admin action taken on a business (block/unblock/plan change/delete/
// impersonate) — not tied to Business via a relation (targetBusinessId is a plain string, not a
// foreign key) so the log entry survives even if the business itself is later deleted, which is
// exactly the action most worth having a durable record of.
model AdminAuditLog {
  id               String   @id @default(cuid())
  actorEmail       String
  action           String // "block" | "unblock" | "set_plan" | "delete" | "impersonate"
  targetBusinessId String
  targetBusinessName String
  details          String? // free-text context, e.g. block reason or old/new plan
  createdAt        DateTime @default(now())

  @@index([targetBusinessId, createdAt])
  @@index([createdAt])
}

// Daily snapshot of fleet-wide business metrics, so the super-admin panel can show a real MRR/
// churn trend instead of only today's point-in-time numbers.
model BusinessMetricSnapshot {
  id             String   @id @default(cuid())
  date           DateTime @unique @db.Date
  mrrIls         Int
  activeCount    Int
  trialCount     Int
  pastDueCount   Int
  canceledCount  Int
  createdAt      DateTime @default(now())
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  token      String   @unique
  expiresAt  DateTime
  used       Boolean  @default(false)

  @@index([businessId])
}

// --- Lead Finder (internal super-admin module: business discovery, enrichment, scoring,
// campaign management). Outreach tables exist here as schema-only groundwork — message
// generation/sending is explicitly out of scope for this pass. Fully isolated from the
// Business/Customer/Appointment booking domain above. ---

model LeadCampaign {
  id            String   @id @default(cuid())
  name          String
  category      String
  locationQuery String // free-text city/region/radius description, e.g. "חיפה, רדיוס 15 ק""מ"
  status        String   @default("draft") // draft | running | paused | completed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  runs  LeadFinderRun[]
  leads Lead[]
}

model LeadFinderRun {
  id            String       @id @default(cuid())
  campaign      LeadCampaign @relation(fields: [campaignId], references: [id])
  campaignId    String
  status        String       @default("pending") // pending | discovering | enriching | scoring | completed | failed
  totalFound    Int          @default(0)
  totalEnriched Int          @default(0)
  totalScored   Int          @default(0)
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())

  @@index([campaignId])
}

model Lead {
  id               String       @id @default(cuid())
  campaign         LeadCampaign @relation(fields: [campaignId], references: [id])
  campaignId       String
  placeId          String?      @unique // Google Places place_id — dedupe key
  name             String
  phone            String?
  address          String?
  website          String?
  category         String?
  rating           Float?
  reviewCount      Int?
  businessHours    Json?
  socialLinks      Json? // not populated by Google Places API — reserved for future enrichment sources
  whatsappDetected Boolean      @default(false)
  hasOnlineBooking Boolean?
  hasContactForm   Boolean?
  websiteStale     Boolean?
  status           String       @default("new") // new | contacted | replied | meeting_scheduled | trial_sent | converted | not_interested
  notes            String?      @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  scores           LeadScore[]
  statusEvents     LeadStatusEvent[]
  profile          LeadProfile?
  outreachMessages OutreachMessage[]
  consentLogs      ConsentLog[]

  @@index([campaignId])
  @@index([campaignId, status])
}

model LeadScore {
  id         String   @id @default(cuid())
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId     String
  version    Int
  totalScore Int
  breakdown  Json // per-factor score contributions
  createdAt  DateTime @default(now())

  @@index([leadId])
}

model LeadProfile {
  id          String   @id @default(cuid())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId      String   @unique
  summary     String   @db.Text
  strengths   Json // string array
  gaps        Json // string array
  whyToriFits String   @db.Text
  generatedAt DateTime
  model       String? // which LLM generated this profile
}

model LeadStatusEvent {
  id         String   @id @default(cuid())
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId     String
  fromStatus String?
  toStatus   String
  note       String?
  createdAt  DateTime @default(now())

  @@index([leadId])
}

// Schema only for this pass — no generation/sending logic implemented yet.
model OutreachMessage {
  id             String    @id @default(cuid())
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId         String
  channel        String // "email" | "manual_call"
  angle          String? // "initial" | "follow_up_1" | ...
  subject        String?
  body           String    @db.Text
  approvalStatus String    @default("draft") // draft | approved | rejected
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([leadId])
}

// Required before any repeat outreach — table exists ahead of the outreach feature itself.
model ConsentLog {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  event     String // "opted_out" | "consented"
  channel   String?
  createdAt DateTime @default(now())

  @@index([leadId])
}

model LeadScoringConfig {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "default"
  weights   Json
  updatedAt DateTime @updatedAt
}
