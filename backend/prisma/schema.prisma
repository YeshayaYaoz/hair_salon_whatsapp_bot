generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Neon's non-pooled connection, used only for migrations. Without it declared here Prisma never
  // reads DIRECT_URL at all, so `prisma migrate deploy` (which runs on every start) went through
  // the pooled URL — and PgBouncer doesn't hold the session-level advisory lock that migrate takes,
  // so a migration can hang or fail there. The runtime client still uses the pooled DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

model Business {
  id                 String @id @default(cuid())
  name               String
  timezone           String @default("Asia/Jerusalem")
  email              String @unique
  passwordHash       String
  subscriptionStatus String @default("trial") // trial | active | past_due | canceled

  // Super-admin block: independent of subscriptionStatus — a blocked business is locked out of
  // login and the bot stops replying, regardless of whether their subscription is otherwise fine
  // (e.g. abuse, fraud, a support dispute), without touching their billing state.
  blockedAt     DateTime?
  blockedReason String?

  // Own-account recurring billing via PayPlus tokens — charges the business (salon owner) for
  // their Tori subscription. Separate from paymentProvider/paymentApiKey above, which are the
  // salon's own merchant account for charging their customers, not this.
  subscriptionPlan          String? // "standard" | "premium"
  subscriptionToken         String? // encrypted at rest — PayPlus recurring charge token
  // PayPlus's Transactions/Charge marks customer_uid mandatory whenever use_token is true. The
  // checkout callback is the only place it is ever handed to us, so it is captured there and kept
  // beside the token it belongs to. Not a secret — an opaque PayPlus id, not card data.
  subscriptionCustomerUid   String?
  // PayPlus caps more_info at 19 characters, which a cuid alone exceeds. The checkout link carries
  // this short reference instead, and the webhook looks the business up by it. plan/cycle can't fit
  // either, so they're parked here when the link is generated and read back on the callback.
  checkoutRef               String?   @unique
  checkoutPlan              String?
  checkoutCycle             String?
  // What the pending hosted-payment page is for: "subscription" (activate a plan) or "wallet"
  // (credit the prepaid balance). Null on rows predating wallet checkouts, which were all
  // subscriptions — the webhook treats null as "subscription" for exactly that reason.
  checkoutPurpose           String?
  // Amount the pending page was generated for, in whole shekels. Needed for wallet top-ups: the
  // credit must come from what we asked for, never from an amount echoed back in the callback.
  checkoutAmountIls         Int?
  nextBillingDate           DateTime?
  lastBillingAttemptAt      DateTime?
  billingCycle              String    @default("monthly") // "monthly" | "annual"
  billingCyclesCompleted    Int       @default(0) // successful charges — drives the loyalty discount
  loyaltyDiscountIls        Int       @default(0) // auto-applied recurring discount once tenure threshold is hit
  // A coupon the business redeemed at signup. The code is stored for support ("which promo did
  // they come in on?"); the money is in couponDiscountIls, and couponCyclesRemaining counts down
  // how many more charges it applies to — null means it never expires.
  couponCode                String?
  couponDiscountIls         Int       @default(0)
  couponCyclesRemaining     Int?
  // The code typed at checkout, held until the payment succeeds. Separate from couponCode above,
  // which means "redeemed": a code parked here has taken nothing off anything yet, and an
  // abandoned checkout must leave no trace of a discount the business never paid for.
  checkoutCouponCode        String?
  couponRedemptions         CouponRedemption[]
  customerCoupons           CustomerCoupon[]
  lastBillingReminderSentAt DateTime? // last "charge in 2 days" heads-up, to avoid duplicates
  // Consecutive failed charges in the current dunning run. Reset to 0 on any success. Drives the
  // retry schedule in subscriptionBillingJob — one declined card must not cut a paying business
  // off the same night.
  billingFailedAttempts     Int       @default(0)
  // Set the moment a charge is claimed for this business, BEFORE the money moves. It is what stops
  // a second run charging the same business again after a crash between PayPlus succeeding and our
  // own update landing — see the claim query in subscriptionBillingJob.
  billingClaimedAt          DateTime?
  walletBalanceAgorot       Int       @default(0) // prepaid balance in agorot (1/100 ILS) — funds metered add-ons once the plan's monthly message quota is exceeded
  messagesUsedThisCycle     Int       @default(0) // proactive WhatsApp sends (reminders/reviews/digests/etc.) counted against the plan quota this billing cycle; reset on each successful charge
  // Highest AI-spend alert step (percent of the plan's inference budget) already emailed to the
  // super admin, so a business parked above the threshold produces one mail and not one an hour.
  // Cleared automatically when 30-day spend falls back under the step — see aiCostAlerts.ts.
  aiCostAlertStepSent       Int       @default(0)
  pendingYieldCampaign      Json? // set when the empty-slot campaign is awaiting the owner's WhatsApp confirmation
  address                   String?
  // Last profile picture uploaded through the dashboard, kept so the widget can show what is
  // currently set instead of an empty camera icon on every page load. Meta stores the picture but
  // exposes it only via a short-lived URL, so a copy of our own is what makes it displayable.
  whatsappProfilePictureUrl String?
  whatsappPhoneNumberId     String?   @unique
  // Phone number for the voice bot, one per salon — same 1:1 routing model as whatsappPhoneNumberId:
  // the number Cartesia's tool call reports as "called" identifies the salon. One shared agent
  // serves every salon, and an agent may hold many numbers, so this stays 1:1 without needing an
  // agent per business.
  voicePhoneNumber          String?   @unique
  // Claimed the instant a number order starts, before the carrier is called, and never cleared on
  // success. Ordering a number begins a recurring monthly charge, so "did we already order one for
  // this business" cannot be answered by voicePhoneNumber alone: that is only set after the order
  // returns, leaving a window in which a second click orders — and pays for — a second number.
  // Claiming this column with a conditional update closes the window in the database rather than in
  // application logic, which is the only place two concurrent requests actually agree.
  voiceNumberOrderedAt      DateTime?
  // Cartesia voice the agent speaks in for this salon, chosen by the owner. Null means the agent's
  // own default — which is what every salon got before this existed, so leaving it unset changes
  // nothing. The agent applies it per call, so one shared agent can still sound different per salon.
  voiceId                   String?
  // Which language the phone bot TRANSCRIBES callers in — "he", "en", or "multilingual".
  //
  // Not cosmetic. Speech recognition pinned to the language actually being spoken is markedly more
  // accurate than one left to guess, and an unpinned transcriber handed Latin letters inside Hebrew
  // speech produced a repetition loop on a real call. But a salon whose callers switch between
  // Hebrew and English cannot be pinned to either, and for them "multilingual" — Cartesia's own
  // auto-detect at the transcription layer — is the right trade: more forgiving, less exact.
  // Defaults to Hebrew, which is what every existing salon is.
  voiceLanguage             String    @default("he")
  whatsappAccessToken       String? // encrypted at rest
  whatsappTokenValid        Boolean   @default(true) // set false when Meta rejects the token (expired/revoked)
  // Captured directly off the Embedded Signup postMessage event at connect time. Re-deriving this
  // later via GET /{phoneNumberId}?fields=whatsapp_business_account has been observed to fail with
  // a misleading "(#100) Tried accessing nonexisting field" error for some tokens even though the
  // same token can subscribe apps and send messages fine — so callers should use this stored value
  // instead of re-querying Meta whenever possible.
  whatsappWabaId            String?
  // Two-step verification PIN used to register the number to the Cloud API. Generated once per
  // business and reused on every re-register — Meta requires the same PIN once one has been set.
  whatsappRegistrationPin   String?
  // Set once the number is successfully registered to the Cloud API. Guards against re-registering
  // on every reconnect/"Fix connection" click — Meta rate-limits registration attempts hard
  // (error 133016, "too many attempts"), and a registered number never needs registering again.
  whatsappRegisteredAt      DateTime?
  // Timestamp of the last /register attempt. Meta's 133016 lockout is a ROLLING 72h window that
  // every new attempt restarts — so we refuse to attempt again within 72h of the last one, which
  // is the only way to actually let the lockout expire instead of endlessly resetting it.
  whatsappRegisterAttemptedAt DateTime?
  // Progress of the hands-off WhatsApp setup we run for a business we issued a number to: the
  // number goes onto Tori's own WABA and we drive Meta's add → verify → register sequence for them.
  // Only these businesses have it; anyone who connected through Embedded Signup leaves it null.
  // Values: ordered | adding | awaiting_code | verifying | registering | done | failed
  whatsappAutoSetupState    String?
  // Why it stopped, in the owner's language. Only meaningful in the failed state.
  whatsappAutoSetupError    String?
  whatsappAutoSetupAt       DateTime?
  // How many verification codes we have asked Meta for. Meta locks a number out after a handful,
  // and the lockout is far more expensive than giving up early and asking a human to look.
  whatsappAutoSetupAttempts Int       @default(0)
  notificationPhone         String? // owner's personal phone for booking alerts, normalized to digits+country code
  // Set the first time a WhatsApp message to notificationPhone actually succeeds — which is the
  // only proof the number is real and reachable. A format check cannot establish that, and the
  // failure it guards against is silent: the bot tells a customer "someone will call you back"
  // while the alert went nowhere. Cleared whenever the number changes.
  notificationPhoneVerifiedAt DateTime?
  // Set the first time the owner writes to their own bot and we tell them what they can do from
  // there. Once only: an owner who already knows does not need the pitch again, and repeating it
  // on every message would make their own bot tiresome to use.
  managerIntroSentAt        DateTime?
  // Set once the owner clicks the link we email them. Null means unverified — which is the state
  // every existing account starts in, so nothing may *require* this to be non-null.
  emailVerifiedAt           DateTime?
  // Business-wide bot kill switch. When false the bot stays silent on every thread (holiday,
  // emergency, "I'll handle it myself today") — distinct from Customer.botPaused, which only
  // silences one conversation after the owner replies manually.
  botEnabled                Boolean   @default(true)
  // Vertical/category this business belongs to (salon | barber | clinic | aesthetics | …). Drives
  // the onboarding template that pre-fills settings and the vocabulary the bot/dashboard use.
  businessType              String?
  businessTypeChosenAt      DateTime? // when the owner first picked a category — gates the first-login picker
  // How the bot handles booking. "slot" (default): real-time availability + booking via the slot
  // engine (salon/clinic/etc). "inquiry": the bot only answers prices/availability info and, when
  // the customer wants to book, alerts the owner to call the customer back — no live booking engine
  // (for verticals like B&B where availability is per-unit/overnight and not slot-based).
  bookingModel              String    @default("slot")
  availabilityInfo          String? // free-text availability summary the bot quotes in "inquiry" mode
  // When false, the bot says nothing at all about availability in "inquiry" mode — it won't quote
  // availabilityInfo or characterise how busy a period is, and always defers to the owner. For
  // businesses where only the owner knows the real calendar, any hint from the bot is a liability.
  availabilitySuggestionsEnabled Boolean @default(true)
  // Whether the owner gets a WhatsApp heads-up when the voice agent sends a caller unit details or
  // photos. Off by default: on a busy line every "customer asked for pictures" is a notification
  // for something the bot already handled, and the owner learns to swipe the whole channel away —
  // which is how the alerts that do need them (a paid deposit, a failed transfer) get missed too.
  notifyOnDetailsSent Boolean @default(false)
  // When true the owner's welcome goes out as its own message, just before the reply. Off by
  // default: two messages for one "שלום" reads as a bot talking to itself. See whatsappRoutes —
  // a configured greeting button forces the split regardless, because WhatsApp allows only one
  // button type per message and the link and the quick replies cannot share it.
  greetingSeparateMessage Boolean @default(false)
  // Pricing caveats that don't fit a per-item price: package rules, seasons where a discount
  // doesn't apply, and excluded dates (e.g. "בין הזמנים — מחיר מלא לכל לילה", "לא כולל ראש השנה").
  // Deliberately separate from availabilityInfo: that answers "is there room?", this answers
  // "what will it cost?", and owners fill them in at different times.
  pricingNotes              String?
  // Which LLM backend answers this business's WhatsApp bot — "anthropic" | "openai" | "deepseek".
  // aiModel overrides the provider's default model id (e.g. "gpt-4o-mini", "deepseek-chat"); null
  // means "use that provider's built-in cheap/smart pair" (see bot/providers/index.ts).
  // DeepSeek by default: it handles this bot's tool-driven workload at a fraction of the cost.
  // getAiProvider falls back to whatever IS configured, so a deployment without a DeepSeek key
  // still answers rather than failing at send time.
  aiProvider                String    @default("deepseek")
  aiModel                   String?
  // Sampling temperature for the bot's replies. Null = use the app default (0.2), which is low on
  // purpose: high temperature is what produced invented Hebrew ("מבורך הבא" for "ברוך הבא"), since
  // Hebrew is full of fixed collocations where any variation is simply wrong. Exposed per-business
  // because some owners want a little more variety in small talk. Note that newer Anthropic models
  // reject the parameter entirely — see anthropicProvider.
  aiTemperature             Float?
  botGreeting               String? // custom greeting override
  // Turns the first reply of a conversation into a WhatsApp interactive message with one tappable
  // button. Both are needed for the button to appear; without them the greeting is sent as plain
  // text exactly as before.
  greetingButtonText        String? // max 20 chars — WhatsApp rejects longer
  greetingButtonUrl         String?
  // Up to 3 tappable replies on the opening message. Takes precedence over the URL button when
  // both are set: WhatsApp allows one interactive type per message, and keeping the customer
  // answering inside the chat beats sending them to a website.
  quickReplies              String[]
  botPersonality            String? // tone/personality instructions for the bot
  googleMapsUrl             String? // linked in post-visit review requests
  // Where someone who cannot use the booking page should write. Published on the business's own
  // accessibility statement at /book/:id/accessibility.
  //
  // Israeli law (reg. 35 of the Equal Rights for Persons with Disabilities (Service Accessibility)
  // Regulations, 2013) requires every business offering a service online to publish an
  // accessibility statement naming a contact for accessibility matters — and that duty falls on
  // the salon, not on us, because the salon is the one providing the service. Optional here
  // because we cannot invent a contact on a business's behalf: with it unset the statement still
  // publishes (which is better than nothing) but tells the visitor to contact the business
  // directly, and the dashboard prompts the owner to fill it in.
  accessibilityContact      String?
  remindersEnabled          Boolean   @default(true)
  reviewsEnabled            Boolean   @default(true)
  cancellationPolicy        String? // shown by the bot when a customer cancels
  referralText              String? // appended to post-visit review messages (e.g. referral discount offer)
  digestEnabled             Boolean   @default(true)
  lastDigestSentAt          DateTime? // last morning-digest send, to avoid duplicates
  lastRoiReportSentAt       DateTime? // last monthly ROI report send, to avoid duplicates

  // Per-business transaction (payment) provider — the salon's own merchant account, not ours.
  paymentProvider  String? // "payplus" | "tranzila" | "cardcom"
  paymentApiKey    String? // encrypted at rest — provider's key/terminal/username
  paymentApiSecret String? // encrypted at rest — provider's secret/password
  // PayPlus only: the uid of the payment page to render. Not a secret (it identifies a page, not
  // an account), and PayPlus rejects generateLink without it — 405
  // not-authorize-missing-payment-page-uid — so a business enabling deposits cannot work until
  // this is filled in. Other providers ignore it.
  paymentPageUid   String?
  // Random per-business secret embedded in the payment webhook URL path (…/webhook/payments/
  // :provider/:businessId/:webhookSecret). Unlike businessId/appointmentId, this is never exposed
  // to the customer (only the payment LINK is; the webhook URL is configured once, server-side, in
  // the provider's own merchant dashboard) — so it's what actually stops a forged POST to the
  // webhook endpoint from confirming a deposit for free. Generated when a payment provider is
  // first connected; see businessRoutes.ts.
  paymentWebhookSecret String?

  // Per-business Israeli invoice/receipt provider — issues the actual חשבונית/קבלה after payment.
  invoiceProvider  String? // "greeninvoice" | "icount"
  invoiceApiKey    String? // encrypted at rest
  invoiceApiSecret String? // encrypted at rest

  // Deposit-before-booking: when enabled (requires a connected paymentProvider), the bot sends a
  // payment link for a fixed deposit instead of confirming the slot outright — the appointment
  // holds the slot as "pending_payment" until paid or it expires. Owner opt-in per spec.
  depositEnabled     Boolean @default(false)
  depositAmountIls   Int     @default(0)
  depositHoldMinutes Int     @default(30) // how long an unpaid hold blocks the slot before auto-expiring

  createdAt DateTime @default(now())

  services            Service[]
  staff               StaffMember[]
  hours               BusinessHours[]
  customers           Customer[]
  appointments        Appointment[]
  faqEntries          FaqEntry[]
  waitlistEntries     WaitlistEntry[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  googleCalendar      GoogleCalendarToken?
  blockedTimes        BlockedTime[]
  specialPeriods      SpecialPeriod[]
  linkedLeads         Lead[] // Lead Finder prospects that turned into this real, paying account
  affiliateReferrals  AffiliateReferral[]
}

// A salon we sent to a provider's signup page through our affiliate link, and whether it came back
// connected.
//
// Two separate things are worth knowing and only one of them is visible to us. The provider's own
// affiliate dashboard reports the signup — we pass businessId as the `ref` sub-id so rows there can
// be matched back to a salon. What we can see on our side is the conversion that actually matters
// to the product: the salon connecting that provider afterwards, which is when convertedAt is set
// and the operator is emailed.
//
// A row per click rather than a flag on Business, because a salon may be referred to more than one
// provider — for payments and for invoicing separately — and the intent is to add more providers.
model AffiliateReferral {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  provider   String // "payplus"
  kind       String // "payments" | "invoice" — one salon can be referred for both
  clickedAt  DateTime @default(now())
  // Set when the salon actually connects this provider for this kind. Null means the click never
  // turned into anything we can see.
  convertedAt DateTime?

  @@unique([businessId, provider, kind])
  @@index([businessId])
}

/// Tracks the last run of each global background job (reminders, reviews, digest, retention) so
/// its health can be surfaced in the dashboard instead of living only in Railway logs.
/// Operator-level values captured at runtime rather than configured by hand. First use: PayPlus's
/// terminal_uid/cashier_uid, which Transactions/Charge requires but no PayPlus API lists — they
/// arrive on every successful checkout callback, so the webhook records them here and the token
/// charge falls back to them when the env vars are unset.
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model SystemJobRun {
  jobName        String   @id
  lastRunAt      DateTime
  lastStatus     String // "ok" | "error"
  lastError      String?
  lastDurationMs Int?
}

/// A date range on which the business operates differently — different pricing, a minimum stay, a
/// special menu, reduced hours. Unlike BlockedTime this does NOT close the calendar: the business
/// is open, the terms are just different, and the bot's job is to say so before quoting anything.
///
/// Stored one row per continuous range rather than as a recurrence rule. Most of these follow the
/// Hebrew calendar (ערב חג, חול המועד, בין הזמנים), which has no expressible recurrence in
/// Gregorian terms — the dates are resolved from a real Hebrew calendar when the owner adds the
/// rule, so what's stored is always concrete dates the owner reviewed and can edit.
///
/// label groups the rows a single rule generated ("ערב חג"), so the dashboard can show one entry
/// with its N dates instead of N unrelated rows.
model SpecialPeriod {
  id          String   @id @default(cuid())
  business    Business @relation(fields: [businessId], references: [id])
  businessId  String
  label       String // what the period is: "ערב חג", "בין הזמנים - ניסן"
  description String // what changes, in the owner's words: "מחיר כפול", "מינימום 3 לילות"
  startDate   DateTime @db.Date // date-only: these are whole days, never times
  endDate     DateTime @db.Date // inclusive
  createdAt   DateTime @default(now())

  @@index([businessId, startDate])
}

/// Owner-defined closures (vacations, lunch breaks, holidays) during which no bookings are allowed.
model BlockedTime {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  startTime  DateTime
  endTime    DateTime
  reason     String?
  createdAt  DateTime @default(now())

  @@index([businessId, startTime])
}

model Service {
  id              String          @id @default(cuid())
  business        Business        @relation(fields: [businessId], references: [id])
  businessId      String
  name            String
  description     String?
  priceCents      Int
  durationMin     Int
  color           String          @default("#8b5cf6")
  // How many people can book the SAME slot of this service at once. 1 = a normal 1:1 appointment
  // (every existing service). >1 = a group class (yoga/fitness) where the slot holds multiple
  // attendees up to this capacity. Kept as a plain per-service count so the 1:1 path is unchanged.
  capacity        Int             @default(1)
  // How many PEOPLE the unit sleeps — a different question from capacity above, which is how many
  // separate bookings share one slot (correctly 1 for a whole rented unit). Overnight verticals
  // only. Null means the owner hasn't said, and nothing may invent a number in its place.
  //
  // Existed only as prose inside description ("מתאים עד 7 אורחים"), which left the model to parse a
  // sentence, total a party across adults/children/infants, and compare — it offered a family of
  // six a three-person unit, and before that pushed a family of five into the ten-person one.
  maxGuests       Int?
  // Optional visual/reference links shown alongside the listing — most useful for verticals like
  // B&B where a "service" is really a rentable unit customers want to see photos of before asking.
  // Plain URLs (an image link, or a page with more photos/details) rather than hosted uploads —
  // no object storage exists in this app yet, and a URL field matches the existing googleMapsUrl
  // pattern rather than introducing new upload infrastructure for this alone.
  // Photos the bot can send when a customer asks to see the unit. Plain URLs rather than uploaded
  // files: there is no object storage in this app, and a URL list needs no new infrastructure.
  imageUrls       String[]
  linkUrl         String?
  appointments    Appointment[]
  waitlistEntries WaitlistEntry[]

  @@index([businessId])
}

model StaffMember {
  id           String        @id @default(cuid())
  business     Business      @relation(fields: [businessId], references: [id])
  businessId   String
  name         String
  appointments Appointment[]

  @@index([businessId])
}

model BusinessHours {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  dayOfWeek  Int // 0 = Sunday ... 6 = Saturday
  openMin    Int // minutes from midnight
  closeMin   Int

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

model Customer {
  id                  String          @id @default(cuid())
  business            Business        @relation(fields: [businessId], references: [id])
  businessId          String
  phone               String
  name                String?
  preferredServiceId  String? // most recently booked service, for CRM memory
  lastRetentionSentAt DateTime? // when we last sent a re-engagement message
  notes               String? // free-text staff note about this customer, shown next to their conversation
  botPaused           Boolean         @default(false) // true once the owner sends a manual message — bot goes silent on this thread until resumed
  botPausedAt         DateTime?
  // Owner pressed "start a fresh conversation". The bot stops reading anything written before this
  // instant, so the next message opens a new thread (greeting, buttons, no stale context) — while
  // ConversationMessage rows are left untouched, so the transcript stays complete in the dashboard.
  conversationResetAt DateTime?
  appointments        Appointment[]
  waitlistEntries     WaitlistEntry[]

  @@unique([businessId, phone])
  @@index([businessId])
}

model Appointment {
  id              String       @id @default(cuid())
  business        Business     @relation(fields: [businessId], references: [id])
  businessId      String
  customer        Customer     @relation(fields: [customerId], references: [id])
  customerId      String
  service         Service      @relation(fields: [serviceId], references: [id])
  serviceId       String
  staff           StaffMember? @relation(fields: [staffId], references: [id])
  staffId         String?
  startTime       DateTime
  endTime         DateTime
  status          String       @default("confirmed") // confirmed | cancelled | pending_payment
  reminderSentAt  DateTime? // set when 24h reminder WhatsApp is sent
  reviewSentAt    DateTime? // set when post-visit review request is sent
  calendarEventId String? // Google Calendar event id, so cancel/reschedule can delete the actual event instead of leaving a ghost
  createdAt       DateTime     @default(now())

  // Deposit tracking — only set when the appointment was created via the deposit-required flow.
  depositAmountIls   Int?
  depositStatus      String?   @default("none") // none | pending | paid
  depositProvider    String? // payment provider name at time of link creation, e.g. "payplus"
  depositPaymentUrl  String?
  depositProviderRef String? // provider's transaction/page id, used to correlate the webhook
  depositExpiresAt   DateTime? // pending_payment holds past this are auto-cancelled to free the slot
  depositPaidAt      DateTime?

  // A customer coupon applied to this booking. The code and the resolved discount are both stored:
  // the code so the owner can see which promotion drove the booking, and the amount because the
  // coupon's terms can change afterwards and this row must keep saying what was actually given.
  couponCode         String?
  couponDiscountIls  Int?

  @@index([businessId, startTime])
  @@index([status, depositExpiresAt])
}

model WaitlistEntry {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String
  service    Service  @relation(fields: [serviceId], references: [id])
  serviceId  String
  notified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([businessId])
}

model FaqEntry {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  question   String
  answer     String

  @@index([businessId])
}

model GoogleCalendarToken {
  id           String   @id @default(cuid())
  business     Business @relation(fields: [businessId], references: [id])
  businessId   String   @unique
  accessToken  String // encrypted
  refreshToken String // encrypted
  expiresAt    DateTime
  calendarId   String   @default("primary")
  updatedAt    DateTime @updatedAt
}

model ConversationMessage {
  id         String   @id @default(cuid())
  businessId String
  phone      String
  role       String // "user" | "assistant"
  content    String
  createdAt  DateTime @default(now())
  // "whatsapp" | "voice". Which medium the turn actually happened on, and it has to be a column
  // rather than an inference: only a real inbound WhatsApp message opens Meta's 24h
  // customer-service window, and this table is what that window is measured from. Phone calls are
  // recorded here too, so without this a call looked exactly like an inbound message — see the
  // window check in lib/ownerNotify.ts. Defaults to whatsapp because every pre-existing row is one.
  channel    String   @default("whatsapp")

  @@index([businessId, phone, createdAt])
}

// Real, per-call usage ledger — no estimates. Every Anthropic API call and every billable
// WhatsApp message actually sent is logged here with its real token counts / billing category, so
// cost-per-phone-number in the super-admin panel reflects what was actually metered by the
// provider, not a guessed average. costAgorot is only populated when we have an authoritative
// published rate to compute it from (Claude token pricing); WhatsApp entries record the real
// category/billable flag Meta itself reports, since Meta doesn't return a $ amount per message —
// only the account's own invoice has that, and we don't fabricate a number to fill the gap.
model ApiUsageEvent {
  id           String   @id @default(cuid())
  businessId   String
  customerPhone String
  kind         String // "claude" | "whatsapp" | "voice_call"
  // Cartesia's own id for a call, on "voice_call" rows only. Unique, because the sync re-reads a
  // window of history on every tick and a call must not be counted twice — the whole point of
  // reading their record rather than timing calls ourselves is that the number is exact.
  externalId   String?  @unique
  // Wall-clock seconds of a live call, as Cartesia recorded it (end_time − start_time). This is
  // the expensive half of a phone call and the half nothing here used to measure: the LLM tokens
  // below cost fractions of an agora, while the minute they were spoken in costs $0.06.
  durationSeconds Int?
  // Cartesia's own one-or-two-sentence summary of the call, delivered by the post_call_analysis
  // webhook. Content rather than metering, and it sits here because the row keyed by this call
  // already exists — but it is the reason a voice_call row is subject to the same deletion as any
  // other customer content when a business is removed.
  summary      String?
  // Two readings taken from the call's own transcript, on voice_call rows written by the webhook.
  // Both were previously unmeasurable outside a benchmark: ttfbMsMedian is the agent's real
  // time-to-first-audio on live calls, and interruptions counts assistant turns the caller talked
  // over — which is what a bot that does not know when to stop sounds like from the other end.
  ttfbMsMedian Int?
  interruptions Int?
  // Which LLM backend served this call — "anthropic" | "openai" | "deepseek". Recorded explicitly
  // rather than derived from `model`, since a business may pin an arbitrary model id that no
  // lookup table would recognise. Null on rows written before multi-provider support existed.
  provider     String?
  model        String? // model id, e.g. "claude-haiku-4-5-20251001" / "deepseek-chat"
  inputTokens  Int? // total billed input, INCLUDING the two cache buckets below
  // Broken out so prompt-cache effectiveness is measurable rather than assumed: a healthy
  // conversation should show cacheReadTokens dominating inputTokens. Both are already counted
  // inside inputTokens — do not add them on top of it.
  cacheReadTokens  Int?
  cacheWriteTokens Int?
  outputTokens Int?
  costAgorot   Int? // only set when computed from a known published rate (Claude); null for WhatsApp
  category     String? // WhatsApp billing category Meta reports: marketing | utility | authentication | service
  billable     Boolean? // WhatsApp: Meta's own "billable" flag for this message
  createdAt    DateTime @default(now())

  @@index([businessId, customerPhone, createdAt])
  @@index([businessId, kind, createdAt])
}

// Records every super-admin action taken on a business (block/unblock/plan change/delete/
// impersonate) — not tied to Business via a relation (targetBusinessId is a plain string, not a
// foreign key) so the log entry survives even if the business itself is later deleted, which is
// exactly the action most worth having a durable record of.
model AdminAuditLog {
  id               String   @id @default(cuid())
  actorEmail       String
  action           String // "block" | "unblock" | "set_plan" | "delete" | "impersonate"
  targetBusinessId String
  targetBusinessName String
  details          String? // free-text context, e.g. block reason or old/new plan
  createdAt        DateTime @default(now())

  @@index([targetBusinessId, createdAt])
  @@index([createdAt])
}

// Daily snapshot of fleet-wide business metrics, so the super-admin panel can show a real MRR/
// churn trend instead of only today's point-in-time numbers.
model BusinessMetricSnapshot {
  id             String   @id @default(cuid())
  date           DateTime @unique @db.Date
  mrrIls         Int
  activeCount    Int
  trialCount     Int
  pastDueCount   Int
  canceledCount  Int
  createdAt      DateTime @default(now())
}

// Proves the owner actually controls the address they signed up with. Without it a typo'd email
// silently swallows password resets and every operational notice we send, and the owner has no
// way to tell — the address looks right in settings.
model EmailVerificationToken {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  // Stored as a SHA-256 hash, not plaintext: this token grants a state change on the account, so
  // a leaked database backup shouldn't hand over usable verification links.
  tokenHash  String   @unique
  email      String // the address being verified — verifying then changing the email must not carry over
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([businessId])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  token      String   @unique
  expiresAt  DateTime
  used       Boolean  @default(false)

  @@index([businessId])
}

// --- Lead Finder (internal super-admin module: business discovery, enrichment, scoring,
// campaign management). Outreach tables exist here as schema-only groundwork — message
// generation/sending is explicitly out of scope for this pass. Fully isolated from the
// Business/Customer/Appointment booking domain above. ---

model LeadCampaign {
  id            String   @id @default(cuid())
  name          String
  category      String
  locationQuery String // free-text city/region/radius description, e.g. "חיפה, רדיוס 15 ק""מ"
  status        String   @default("draft") // draft | running | paused | completed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  runs  LeadFinderRun[]
  leads Lead[]
}

model LeadFinderRun {
  id            String       @id @default(cuid())
  campaign      LeadCampaign @relation(fields: [campaignId], references: [id])
  campaignId    String
  status        String       @default("pending") // pending | discovering | enriching | scoring | completed | failed
  totalFound    Int          @default(0)
  totalEnriched Int          @default(0)
  totalScored   Int          @default(0)
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())

  @@index([campaignId])
}

model Lead {
  id               String       @id @default(cuid())
  campaign         LeadCampaign @relation(fields: [campaignId], references: [id])
  campaignId       String
  placeId          String?      @unique // Google Places place_id — dedupe key
  name             String
  phone            String?
  email            String? // best-effort, scraped off the lead's own website (mailto: link/contact text) during enrichment — never guaranteed
  address          String?
  website          String?
  category         String?
  rating           Float?
  reviewCount      Int?
  businessHours    Json?
  socialLinks      Json? // not populated by Google Places API — reserved for future enrichment sources
  whatsappDetected Boolean      @default(false)
  hasOnlineBooking Boolean?
  hasContactForm   Boolean?
  websiteStale     Boolean?
  status           String       @default("new") // new | contacted | replied | meeting_scheduled | trial_sent | converted | not_interested
  notes            String?      @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Set once this prospect becomes a real Tori account — either by creating a trial account
  // directly from the lead card, or by manually linking to a business that self-signed-up. This
  // is what makes campaign ROI/conversion tracking real instead of just a status label.
  linkedBusiness   Business?    @relation(fields: [linkedBusinessId], references: [id])
  linkedBusinessId String?

  scores           LeadScore[]
  statusEvents     LeadStatusEvent[]
  profile          LeadProfile?
  outreachMessages OutreachMessage[]
  consentLogs      ConsentLog[]

  @@index([campaignId])
  @@index([campaignId, status])
  @@index([linkedBusinessId])
}

model LeadScore {
  id         String   @id @default(cuid())
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId     String
  version    Int
  totalScore Int
  breakdown  Json // per-factor score contributions
  createdAt  DateTime @default(now())

  @@index([leadId])
}

model LeadProfile {
  id          String   @id @default(cuid())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId      String   @unique
  summary     String   @db.Text
  strengths   Json // string array
  gaps        Json // string array
  whyToriFits String   @db.Text
  generatedAt DateTime
  model       String? // which LLM generated this profile
}

model LeadStatusEvent {
  id         String   @id @default(cuid())
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId     String
  fromStatus String?
  toStatus   String
  note       String?
  createdAt  DateTime @default(now())

  @@index([leadId])
}

// Schema only for this pass — no generation/sending logic implemented yet.
model OutreachMessage {
  id             String    @id @default(cuid())
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId         String
  channel        String // "email" | "manual_call"
  angle          String? // "initial" | "follow_up_1" | ...
  subject        String?
  body           String    @db.Text
  approvalStatus String    @default("draft") // draft | approved | rejected
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([leadId])
}

// Required before any repeat outreach — table exists ahead of the outreach feature itself.
model ConsentLog {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  event     String // "opted_out" | "consented"
  channel   String?
  createdAt DateTime @default(now())

  @@index([leadId])
}

model LeadScoringConfig {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "default"
  weights   Json
  updatedAt DateTime @updatedAt
}

// A discount code for Tori's OWN subscriptions — the operator's growth lever, not anything a
// salon offers its customers (that is CustomerCoupon).
//
// Money is stored as a type + value rather than a resolved shekel figure: a percentage has to be
// recomputed per plan, and freezing it at creation time would silently misprice every plan but the
// one it was created against.
model Coupon {
  id              String    @id @default(cuid())
  // Compared case-insensitively at redemption, stored uppercase so the stored form is canonical.
  code            String    @unique
  // "percent" (value = 0-100) | "fixed" (value = whole shekels off)
  discountType    String
  discountValue   Int
  // How many billing cycles the discount survives. 1 = first charge only, null = forever. A
  // forever-coupon is a permanent revenue cut, so the admin UI names it as such.
  durationCycles  Int?
  // Null = unlimited. Compared against redeemedCount, which is incremented inside the same
  // transaction that records the redemption, so two simultaneous redemptions cannot both pass.
  maxRedemptions  Int?
  redeemedCount   Int       @default(0)
  expiresAt       DateTime?
  active          Boolean   @default(true)
  // Empty = every plan. Otherwise the plan keys this code is valid for.
  allowedPlans    String[]  @default([])
  note            String?   // free text for the operator: which campaign, who it was for
  createdAt       DateTime  @default(now())
  redemptions     CouponRedemption[]
}

// One business redeeming one coupon. Its own table rather than a counter on Business because the
// unique constraint is what enforces "once per business", and because "who used LAUNCH50" is a
// question the operator will ask.
model CouponRedemption {
  id          String   @id @default(cuid())
  couponId    String
  coupon      Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  discountIls Int      // what it actually took off, resolved at redemption
  plan        String
  redeemedAt  DateTime @default(now())

  @@unique([couponId, businessId])
  @@index([businessId])
}

// A discount code a BUSINESS offers its own customers — "new client 20% off", "בין הזמנים".
// Entirely separate from Coupon, which discounts Tori's own subscriptions: different owner,
// different money, different audience. Sharing one table would have made every query start by
// asking which kind it was looking at.
model CustomerCoupon {
  id             String   @id @default(cuid())
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String
  // Unique per business, not globally: two salons may both run "WELCOME10" and neither should
  // block the other.
  code           String
  // "percent" (value = 0-100) | "fixed" (value = whole shekels off)
  discountType   String
  discountValue  Int
  // Empty = every service. Otherwise the services this code is valid on.
  serviceIds     String[] @default([])
  maxUses        Int?     // null = unlimited
  usedCount      Int      @default(0)
  // When true, a phone number that already used this code is refused. The common case for a
  // "new customer" promotion, and the thing an owner assumes is on by default.
  onePerCustomer Boolean  @default(true)
  expiresAt      DateTime?
  active         Boolean  @default(true)
  description    String?  // shown to the customer by the bot when the code is accepted
  createdAt      DateTime @default(now())
  redemptions    CustomerCouponRedemption[]

  @@unique([businessId, code])
  @@index([businessId])
}

// One customer redeeming one of a business's coupons. Keyed on the phone number rather than the
// Customer row: the bot knows the number before it has resolved or created a customer, and the
// per-customer limit has to hold on the first message, not only after a record exists.
model CustomerCouponRedemption {
  id            String         @id @default(cuid())
  coupon        CustomerCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  couponId      String
  customerPhone String
  appointmentId String?
  discountIls   Int
  redeemedAt    DateTime       @default(now())

  @@index([couponId, customerPhone])
}
