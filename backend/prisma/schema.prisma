generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id                String   @id @default(cuid())
  name              String
  timezone          String   @default("Asia/Jerusalem")
  email             String   @unique
  passwordHash      String
  subscriptionStatus String  @default("trial") // trial | active | past_due | canceled
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  address           String?
  whatsappPhoneNumberId String? @unique
  whatsappAccessToken   String? // encrypted at rest
  notificationPhone     String? // owner's personal phone for booking alerts
  botGreeting           String? // custom greeting override
  botPersonality        String? // tone/personality instructions for the bot
  googleMapsUrl         String? // linked in post-visit review requests
  remindersEnabled      Boolean  @default(true)
  reviewsEnabled        Boolean  @default(true)
  createdAt         DateTime @default(now())

  services       Service[]
  staff          StaffMember[]
  hours          BusinessHours[]
  customers      Customer[]
  appointments   Appointment[]
  faqEntries     FaqEntry[]
  waitlistEntries WaitlistEntry[]
  passwordResetTokens PasswordResetToken[]
  googleCalendar      GoogleCalendarToken?
}

model Service {
  id          String   @id @default(cuid())
  business    Business @relation(fields: [businessId], references: [id])
  businessId  String
  name        String
  description String?
  priceCents  Int
  durationMin Int
  color       String  @default("#8b5cf6")
  appointments    Appointment[]
  waitlistEntries WaitlistEntry[]

  @@index([businessId])
}

model StaffMember {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  name       String
  appointments Appointment[]

  @@index([businessId])
}

model BusinessHours {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  dayOfWeek  Int      // 0 = Sunday ... 6 = Saturday
  openMin    Int      // minutes from midnight
  closeMin   Int

  @@index([businessId])
  @@unique([businessId, dayOfWeek])
}

model Customer {
  id          String   @id @default(cuid())
  business    Business @relation(fields: [businessId], references: [id])
  businessId  String
  phone       String
  name        String?
  preferredServiceId String? // most recently booked service, for CRM memory
  lastRetentionSentAt DateTime? // when we last sent a re-engagement message
  appointments    Appointment[]
  waitlistEntries WaitlistEntry[]

  @@index([businessId])
  @@unique([businessId, phone])
}

model Appointment {
  id          String   @id @default(cuid())
  business    Business @relation(fields: [businessId], references: [id])
  businessId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  customerId  String
  service     Service  @relation(fields: [serviceId], references: [id])
  serviceId   String
  staff       StaffMember? @relation(fields: [staffId], references: [id])
  staffId     String?
  startTime       DateTime
  endTime         DateTime
  status          String   @default("confirmed") // confirmed | cancelled
  reminderSentAt  DateTime? // set when 24h reminder WhatsApp is sent
  reviewSentAt    DateTime? // set when post-visit review request is sent
  createdAt       DateTime @default(now())

  @@index([businessId, startTime])
}

model WaitlistEntry {
  id         String      @id @default(cuid())
  business   Business    @relation(fields: [businessId], references: [id])
  businessId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  customerId String
  service    Service     @relation(fields: [serviceId], references: [id])
  serviceId  String
  notified   Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@index([businessId])
}

model FaqEntry {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  question   String
  answer     String

  @@index([businessId])
}

model GoogleCalendarToken {
  id            String   @id @default(cuid())
  business      Business @relation(fields: [businessId], references: [id])
  businessId    String   @unique
  accessToken   String   // encrypted
  refreshToken  String   // encrypted
  expiresAt     DateTime
  calendarId    String   @default("primary")
  updatedAt     DateTime @updatedAt
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  token      String   @unique
  expiresAt  DateTime
  used       Boolean  @default(false)

  @@index([businessId])
}
