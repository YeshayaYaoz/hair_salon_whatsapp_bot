# Database — paste the Postgres connection string from Railway's database service Variables tab
DATABASE_URL="postgresql://user:password@host:5432/dbname"
# Non-pooled connection, used only by `prisma migrate` (declared as directUrl in schema.prisma).
# Required whenever Prisma resolves the datasource — `prisma validate` and `migrate` both fail
# without it. On Neon this is the same URL with "-pooler" removed from the host. For a plain local
# Postgres there is no pooler, so just repeat DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# Auth — generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Encryption key for WhatsApp tokens (same generation method as JWT_SECRET)
TOKEN_ENCRYPTION_KEY="change-me-to-a-long-random-string-used-to-encrypt-whatsapp-tokens"

# Anthropic — from console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# WhatsApp — any string you choose, must match what you paste in Meta console callback
WHATSAPP_VERIFY_TOKEN="choose-a-shared-secret-for-meta-webhook-verification"
# WhatsApp App Secret — from Meta App Dashboard > App Settings > Basic; used to verify X-Hub-Signature-256
WHATSAPP_APP_SECRET="your-meta-app-secret"
# Meta App ID — from Meta App Dashboard > App Settings > Basic
META_APP_ID="your-meta-app-id"

# Stripe — from dashboard.stripe.com
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID="price_..."

# Your Vercel frontend URL (for CORS)
FRONTEND_URL="https://your-app.vercel.app"

PORT=4000

# Where owner-uploaded unit photos are written. In production this MUST be the mount path of a
# Railway volume — the container filesystem is ephemeral, so anything written elsewhere is gone on
# the next deploy. Create the volume in Railway (service → Settings → Volumes), mount it at /data,
# and set this to /data/uploads.
UPLOADS_DIR=./uploads
