NEXT_PUBLIC_API_URL="http://localhost:4000"
# Meta App ID — from Meta App Dashboard > App Settings > Basic (same value as backend META_APP_ID)
NEXT_PUBLIC_META_APP_ID="your-meta-app-id"
# Meta Embedded Signup Config ID — from Meta App Dashboard > WhatsApp > Embedded Signup
NEXT_PUBLIC_META_CONFIG_ID="your-meta-config-id"
# Tori's own WhatsApp number for the public demo, digits with country code (e.g. 9725XXXXXXX).
# When set, the landing page's demo section opens a real WhatsApp chat with "דמו" pre-filled.
NEXT_PUBLIC_DEMO_WHATSAPP=
# Marketing measurement, each loaded only when set — see app/lib/Analytics.tsx.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
